{
  "name": "pickertime",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:preflight": "node tools/test/preflight.mjs",
    "test:seed": "node tools/test/seed.mjs",
    "test:enum": "node tools/test/enum-contract.mjs",
    "test:docs": "node tools/test/docs-contract.mjs",
    "test:snapshot": "bash tools/test/node-gate.sh node tools/test/snapshot-f57.mjs",
    "test:findings": "bash tools/test/node-gate.sh node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/test/findings.mjs",
    "test:batch": "bash tools/test/node-gate.sh node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/test/task-batch.mjs",
    "test:ai-proxy": "bash tools/test/node-gate.sh node tools/test/ai-proxy.mjs",
    "test:device:up": "bash tools/test/device-up.sh",
    "test:device:routes": "bash tools/test/device-routes.sh",
    "test:probe": "bash tools/test/device-probe.sh",
    "test:bundle": "node tools/test/bundle-url.mjs",
    "test:auth:inject": "bash tools/test/node-gate.sh node --experimental-sqlite tools/test/auth-inject.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.34",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.11",
    "expo-linking": "~8.0.12",
    "expo-notifications": "^0.32.17",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "nativewind": "^4.2.3",
    "pocketbase": "^0.26.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-chart-kit": "^6.12.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "^3.4.19",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "private": true
}
